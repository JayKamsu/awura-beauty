# Awura Beauty — modèle d'environnement (sans secrets)
# Copier vers .env.local et renseigner les valeurs.

# Supabase (Dashboard → Connect / Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://jciwbpukqiivtivaksib.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optionnel : pour lancer supabase/setup.mjs (migrations SQL auto)
# Database → Connection string → URI (mode Session)
DATABASE_URL=

# Stripe (mode test) — brancher quand prêt
# Tant que STRIPE_SECRET_KEY et PAYPAL_CLIENT_SECRET sont vides,
# le checkout propose « Commander sans paiement (test) ».
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook : https://www.awurabeauty.com/api/checkout/stripe/webhook
# Événement : checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# PayPal (Sandbox) — brancher quand prêt
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Prod : https://api-m.paypal.com

# API La Poste
LAPOSTE_API_KEY=
LAPOSTE_CONTRACT_NUMBER=

# Mondial Relay — API 1 SOAP (pas Connect API 2)
# Prod : enseigne + clé privée + brand code numériques du portail (ex. 41)
# Test : enseigne test + brand 99 + MODE=sandbox
MONDIAL_RELAY_ENSEIGNE=
MONDIAL_RELAY_PRIVATE_KEY=
MONDIAL_RELAY_BRAND_CODE=
MONDIAL_RELAY_MODE=production
# MONDIAL_RELAY_WSDL_URL=https://api.mondialrelay.com/WebService.asmx
# Étiquette auto après paiement (défaut: activé). false pour désactiver.
# SHIPPING_AUTO_LABEL_ON_PAID=true
# Secret pour cron sync suivi : POST /api/shipping/sync + header x-cron-secret
# CRON_SECRET=

# Auth Google (Supabase) — Client ID/Secret se configurent dans
# Supabase Dashboard → Authentication → Providers → Google
# (ou via: node scripts/configure-supabase-google.mjs --client-id=... --client-secret=...)
# Redirect URI Google obligatoire :
# https://jciwbpukqiivtivaksib.supabase.co/auth/v1/callback

# Firebase Cloud Messaging (push web + navigateur mobile)
# 1) Console Firebase → Ajouter app Web → coller la config ci-dessous
# 2) Project settings → Cloud Messaging → Web Push certificates (VAPID)
# 3) Compte de service → clé JSON → PROJECT_ID / CLIENT_EMAIL / PRIVATE_KEY
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# App (production)
# Domaine principal Hostinger : awurabeauty.com (canonique sans www, ou www avec redirect).
NEXT_PUBLIC_SITE_URL=https://awurabeauty.com

# Google Search Console
# Fichier HTML : public/google5d20140214b8dfee.html
# Balise meta (déployée automatiquement) :
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=ulugKK_si80ZM209r2iNgEwmYKmIjxDwLouE3Objj28
NEXT_PUBLIC_CONTACT_EMAIL=Care@awurabeauty.com

# SMTP — envoi du reçu de commande par e-mail au client à la confirmation de
# paiement. Même boîte que celle configurée pour les e-mails Supabase Auth
# (voir supabase/email-templates/README.md). Tant que SMTP_PASSWORD est vide,
# l'envoi est un no-op silencieux (le paiement n'est jamais bloqué).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=Care@awurabeauty.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Care@awurabeauty.com
SMTP_FROM_NAME=Awura Beauty

# Infos légales affichées sur les reçus de paiement (optionnel)
# NEXT_PUBLIC_COMPANY_LEGAL_NAME=Awura Beauty SAS
# NEXT_PUBLIC_COMPANY_ADDRESS=12 rue Exemple, 75000 Paris
# NEXT_PUBLIC_COMPANY_SIRET=00000000000000
# NEXT_PUBLIC_COMPANY_VAT=FR00000000000

# Admin (production)
# Compte avec app_metadata.role = "admin" + SUPABASE_SERVICE_ROLE_KEY obligatoire.
# ADMIN_DEV_BYPASS doit rester false en production.
# ADMIN_EMAILS : allowlist serveur (ex. admin@awura.local,Care@awurabeauty.com)
# Doit aussi être renseigné dans Vercel → Settings → Environment Variables.
ADMIN_DEV_BYPASS=false
ADMIN_EMAILS=

# Visio diagnostic (Jitsi) — secret HMAC pour les liens d’accès RDV.
# En prod : chaîne aléatoire longue. Sinon fallback SUPABASE_SERVICE_ROLE_KEY.
DIAGNOSTIC_VIDEO_SECRET=

# Sentry (erreurs production)
# Créer un projet Next.js sur https://sentry.io puis coller le DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# Upload des source maps (optionnel, build CI)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
