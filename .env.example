# Awura Beauty — modèle d'environnement (sans secrets)
# Copier vers .env.local et renseigner les valeurs.

# Supabase (Dashboard → Connect / Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://jciwbpukqiivtivaksib.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optionnel : pour lancer supabase/setup.mjs (migrations SQL auto)
# Database → Connection string → URI (mode Session)
DATABASE_URL=

# Stripe (mode test)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (Sandbox)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# API La Poste
LAPOSTE_API_KEY=
LAPOSTE_CONTRACT_NUMBER=

# Mondial Relay
MONDIAL_RELAY_ENSEIGNE=
MONDIAL_RELAY_PRIVATE_KEY=
MONDIAL_RELAY_BRAND_CODE=
MONDIAL_RELAY_MODE=sandbox

# Firebase (notifications — stub tant que non configuré)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# App (production)
# Domaine principal Hostinger : awurabeauty.com (canonique sans www, ou www avec redirect).
NEXT_PUBLIC_SITE_URL=https://awurabeauty.com
NEXT_PUBLIC_CONTACT_EMAIL=Care@awurabeauty.com

# Admin (production)
# Compte avec app_metadata.role = "admin" + SUPABASE_SERVICE_ROLE_KEY obligatoire.
# ADMIN_DEV_BYPASS doit rester false en production.
ADMIN_DEV_BYPASS=false
ADMIN_EMAILS=


# Sentry (erreurs production)
# Créer un projet Next.js sur https://sentry.io puis coller le DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# Upload des source maps (optionnel, build CI)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
